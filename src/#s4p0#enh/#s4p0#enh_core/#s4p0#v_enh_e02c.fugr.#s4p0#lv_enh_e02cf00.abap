FORM DB_UPD_/S4P0/V_ENH_E02C .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO /S4P0/V_ENH_E02C.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_/S4P0/V_ENH_E02C-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E02C WHERE
  ENHANCEMENT = /S4P0/V_ENH_E02C-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E02C-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E02C-FEATURE AND
  PARAM_NAME = /S4P0/V_ENH_E02C-PARAM_NAME AND
  PARAM_COUNTER = /S4P0/V_ENH_E02C-PARAM_COUNTER AND
  PARAM_ORG1 = /S4P0/V_ENH_E02C-PARAM_ORG1 AND
  PARAM_ORG2 = /S4P0/V_ENH_E02C-PARAM_ORG2 AND
  PARAM_FREE_KEY = /S4P0/V_ENH_E02C-PARAM_FREE_KEY .
    IF SY-SUBRC = 0.
    DELETE /S4P0/T_ENH_E02C .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E02C WHERE
  ENHANCEMENT = /S4P0/V_ENH_E02C-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E02C-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E02C-FEATURE AND
  PARAM_NAME = /S4P0/V_ENH_E02C-PARAM_NAME AND
  PARAM_COUNTER = /S4P0/V_ENH_E02C-PARAM_COUNTER AND
  PARAM_ORG1 = /S4P0/V_ENH_E02C-PARAM_ORG1 AND
  PARAM_ORG2 = /S4P0/V_ENH_E02C-PARAM_ORG2 AND
  PARAM_FREE_KEY = /S4P0/V_ENH_E02C-PARAM_FREE_KEY .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR /S4P0/T_ENH_E02C.
    ENDIF.
/S4P0/T_ENH_E02C-MANDT =
/S4P0/V_ENH_E02C-MANDT .
