*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: /S4P0/V_ENH_E01.................................*
FORM GET_DATA_/S4P0/V_ENH_E01.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM /S4P0/T_ENH_E01 WHERE
(VIM_WHERETAB) .
    CLEAR /S4P0/V_ENH_E01 .
/S4P0/V_ENH_E01-MANDT =
/S4P0/T_ENH_E01-MANDT .
/S4P0/V_ENH_E01-ENHANCEMENT =
/S4P0/T_ENH_E01-ENHANCEMENT .
/S4P0/V_ENH_E01-SUB_ENHANCEMENT =
/S4P0/T_ENH_E01-SUB_ENHANCEMENT .
/S4P0/V_ENH_E01-FEATURE =
/S4P0/T_ENH_E01-FEATURE .
/S4P0/V_ENH_E01-PRDKT =
/S4P0/T_ENH_E01-PRDKT .
/S4P0/V_ENH_E01-ACTIVE =
/S4P0/T_ENH_E01-ACTIVE .
/S4P0/V_ENH_E01-TRACK_USAGE =
/S4P0/T_ENH_E01-TRACK_USAGE .
/S4P0/V_ENH_E01-TRACKING_REMARK =
/S4P0/T_ENH_E01-TRACKING_REMARK .
/S4P0/V_ENH_E01-DOCU_LINK =
/S4P0/T_ENH_E01-DOCU_LINK .
    SELECT SINGLE * FROM /S4P0/T_ENH_E01T WHERE
ENHANCEMENT = /S4P0/T_ENH_E01-ENHANCEMENT AND
SUB_ENHANCEMENT = /S4P0/T_ENH_E01-SUB_ENHANCEMENT AND
FEATURE = /S4P0/T_ENH_E01-FEATURE AND
SPRAS = SY-LANGU .
    IF SY-SUBRC EQ 0.
/S4P0/V_ENH_E01-TEXT50 =
/S4P0/T_ENH_E01T-TEXT50 .
    ENDIF.
<VIM_TOTAL_STRUC> = /S4P0/V_ENH_E01.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_/S4P0/V_ENH_E01 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO /S4P0/V_ENH_E01.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_/S4P0/V_ENH_E01-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E01 WHERE
  ENHANCEMENT = /S4P0/V_ENH_E01-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E01-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E01-FEATURE .
    IF SY-SUBRC = 0.
    DELETE /S4P0/T_ENH_E01 .
    ENDIF.
    DELETE FROM /S4P0/T_ENH_E01T WHERE
    ENHANCEMENT = /S4P0/T_ENH_E01-ENHANCEMENT AND
    SUB_ENHANCEMENT = /S4P0/T_ENH_E01-SUB_ENHANCEMENT AND
    FEATURE = /S4P0/T_ENH_E01-FEATURE .
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E01 WHERE
  ENHANCEMENT = /S4P0/V_ENH_E01-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E01-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E01-FEATURE .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR /S4P0/T_ENH_E01.
    ENDIF.
/S4P0/T_ENH_E01-MANDT =
/S4P0/V_ENH_E01-MANDT .
/S4P0/T_ENH_E01-ENHANCEMENT =
/S4P0/V_ENH_E01-ENHANCEMENT .
/S4P0/T_ENH_E01-SUB_ENHANCEMENT =
/S4P0/V_ENH_E01-SUB_ENHANCEMENT .
/S4P0/T_ENH_E01-FEATURE =
/S4P0/V_ENH_E01-FEATURE .
/S4P0/T_ENH_E01-PRDKT =
/S4P0/V_ENH_E01-PRDKT .
/S4P0/T_ENH_E01-ACTIVE =
/S4P0/V_ENH_E01-ACTIVE .
/S4P0/T_ENH_E01-TRACK_USAGE =
/S4P0/V_ENH_E01-TRACK_USAGE .
/S4P0/T_ENH_E01-TRACKING_REMARK =
/S4P0/V_ENH_E01-TRACKING_REMARK .
/S4P0/T_ENH_E01-DOCU_LINK =
/S4P0/V_ENH_E01-DOCU_LINK .
    IF SY-SUBRC = 0.
    UPDATE /S4P0/T_ENH_E01 ##WARN_OK.
    ELSE.
    INSERT /S4P0/T_ENH_E01 .
    ENDIF.
    SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E01T WHERE
    ENHANCEMENT = /S4P0/T_ENH_E01-ENHANCEMENT AND
    SUB_ENHANCEMENT = /S4P0/T_ENH_E01-SUB_ENHANCEMENT AND
    FEATURE = /S4P0/T_ENH_E01-FEATURE AND
    SPRAS = SY-LANGU .
      IF SY-SUBRC <> 0.   "insert preprocessing: init WA
        CLEAR /S4P0/T_ENH_E01T.
/S4P0/T_ENH_E01T-ENHANCEMENT =
/S4P0/T_ENH_E01-ENHANCEMENT .
/S4P0/T_ENH_E01T-SUB_ENHANCEMENT =
/S4P0/T_ENH_E01-SUB_ENHANCEMENT .
/S4P0/T_ENH_E01T-FEATURE =
/S4P0/T_ENH_E01-FEATURE .
/S4P0/T_ENH_E01T-SPRAS =
SY-LANGU .
      ENDIF.
/S4P0/T_ENH_E01T-TEXT50 =
/S4P0/V_ENH_E01-TEXT50 .
    IF SY-SUBRC = 0.
    UPDATE /S4P0/T_ENH_E01T ##WARN_OK.
    ELSE.
    INSERT /S4P0/T_ENH_E01T .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_/S4P0/V_ENH_E01-UPD_FLAG,
STATUS_/S4P0/V_ENH_E01-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
