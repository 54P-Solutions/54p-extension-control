/S4P0/T_ENH_E01C-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = '/S4P0/T_ENH_E01C'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN /S4P0/T_ENH_E01C TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
