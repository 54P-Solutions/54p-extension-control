*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: /S4P0/V_ENH_E01C................................*
FORM GET_DATA_/S4P0/V_ENH_E01C.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM /S4P0/T_ENH_E01C WHERE
(VIM_WHERETAB) .
    CLEAR /S4P0/V_ENH_E01C .
/S4P0/V_ENH_E01C-MANDT =
/S4P0/T_ENH_E01C-MANDT .
/S4P0/V_ENH_E01C-ENHANCEMENT =
/S4P0/T_ENH_E01C-ENHANCEMENT .
/S4P0/V_ENH_E01C-SUB_ENHANCEMENT =
/S4P0/T_ENH_E01C-SUB_ENHANCEMENT .
/S4P0/V_ENH_E01C-FEATURE =
/S4P0/T_ENH_E01C-FEATURE .
/S4P0/V_ENH_E01C-ACTIVE =
/S4P0/T_ENH_E01C-ACTIVE .
/S4P0/V_ENH_E01C-VALID_TO_TSTP =
/S4P0/T_ENH_E01C-VALID_TO_TSTP .
    SELECT SINGLE * FROM /S4P0/T_ENH_E01 WHERE
ENHANCEMENT = /S4P0/T_ENH_E01C-ENHANCEMENT AND
SUB_ENHANCEMENT = /S4P0/T_ENH_E01C-SUB_ENHANCEMENT AND
FEATURE = /S4P0/T_ENH_E01C-FEATURE .
    IF SY-SUBRC EQ 0.
      SELECT SINGLE * FROM /S4P0/T_ENH_E01T WHERE
ENHANCEMENT = /S4P0/T_ENH_E01-ENHANCEMENT AND
SUB_ENHANCEMENT = /S4P0/T_ENH_E01-SUB_ENHANCEMENT AND
FEATURE = /S4P0/T_ENH_E01-FEATURE AND
SPRAS = SY-LANGU .
      IF SY-SUBRC EQ 0.
/S4P0/V_ENH_E01C-TEXT50 =
/S4P0/T_ENH_E01T-TEXT50 .
      ENDIF.
    ENDIF.
<VIM_TOTAL_STRUC> = /S4P0/V_ENH_E01C.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_/S4P0/V_ENH_E01C .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO /S4P0/V_ENH_E01C.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_/S4P0/V_ENH_E01C-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E01C WHERE
  ENHANCEMENT = /S4P0/V_ENH_E01C-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E01C-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E01C-FEATURE .
    IF SY-SUBRC = 0.
    DELETE /S4P0/T_ENH_E01C .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM /S4P0/T_ENH_E01C WHERE
  ENHANCEMENT = /S4P0/V_ENH_E01C-ENHANCEMENT AND
  SUB_ENHANCEMENT = /S4P0/V_ENH_E01C-SUB_ENHANCEMENT AND
  FEATURE = /S4P0/V_ENH_E01C-FEATURE .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR /S4P0/T_ENH_E01C.
    ENDIF.
/S4P0/T_ENH_E01C-MANDT =
/S4P0/V_ENH_E01C-MANDT .
/S4P0/T_ENH_E01C-ENHANCEMENT =
/S4P0/V_ENH_E01C-ENHANCEMENT .
/S4P0/T_ENH_E01C-SUB_ENHANCEMENT =
/S4P0/V_ENH_E01C-SUB_ENHANCEMENT .
/S4P0/T_ENH_E01C-FEATURE =
/S4P0/V_ENH_E01C-FEATURE .
/S4P0/T_ENH_E01C-ACTIVE =
/S4P0/V_ENH_E01C-ACTIVE .
/S4P0/T_ENH_E01C-VALID_TO_TSTP =
/S4P0/V_ENH_E01C-VALID_TO_TSTP .
    IF SY-SUBRC = 0.
    UPDATE /S4P0/T_ENH_E01C ##WARN_OK.
    ELSE.
    INSERT /S4P0/T_ENH_E01C .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_/S4P0/V_ENH_E01C-UPD_FLAG,
STATUS_/S4P0/V_ENH_E01C-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
